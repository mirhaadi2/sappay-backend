{
  "name": "sappey-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "migration:create": "npx sequelize-cli migration:generate --name",
    "migration:status": "npx sequelize-cli db:migrate:status",
    "migration:up": "npx sequelize-cli db:migrate",
    "migration:down": "npx sequelize-cli db:migrate:undo",
    "migration:down:all": "npx sequelize-cli db:migrate:undo:all",
    "migrate": "node scripts/safe-migration.js",
    "migrate:backup": "node scripts/backup-database.js",
    "migrate:restore": "node scripts/restore-backup.js",
    "backup:cleanup": "node scripts/cleanup-backups.js",
    "migrate:specific": "node scripts/migrate-specific.js",
    "seed:create": "npx sequelize-cli seed:generate --name",
    "seed:up": "npx sequelize-cli db:seed:all",
    "seed:down": "npx sequelize-cli db:seed:undo:all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1012.0",
    "@aws-sdk/client-sns": "^3.1029.0",
    "@aws-sdk/credential-providers": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1013.0",
    "@upstash/redis": "^1.38.0",
    "@xmldom/xmldom": "^0.9.8",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^7.0.0",
    "jsbarcode": "^3.12.1",
    "jsdom": "^29.0.2",
    "jsonwebtoken": "^8.5.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.2",
    "pg": "^8.10.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "redis": "^5.11.0",
    "sequelize": "^6.33.0",
    "umzug": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/bcrypt": "^5.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.6",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.4.5"
  }
}
