# Rename this file to `.env` and fill in the values.

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/sappay

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1h

# Session
SESSION_SECRET=your_session_secret
SESSION_COOKIE_NAME=sappay_session
