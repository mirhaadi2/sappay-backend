# Rename this file to `.env` and fill in the values.

# ============ Server Configuration ============
PORT=4000
NODE_ENV=development

# CORS Origins - list of allowed frontend URLs
FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# ============ Database Configuration ============
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/sappay

# ============ Redis Configuration ============
# Used for session storage and caching
REDIS_URL=redis://localhost:6379

# ============ JWT Configuration ============
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1h

# ============ Session Configuration ============
SESSION_SECRET=your_session_secret
SESSION_COOKIE_NAME=sappay_session

# ============ Email Configuration (SMTP) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_PASSWORD=your-app-specific-password

# ============ AWS Configuration (SMS via SNS) ============
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SMS_ENTITY_ID=your-entity-id
AWS_SMS_ORIGINATION_ID=your-origination-id
AWS_SNS_EMAIL_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789:email-topic

# ============ WhatsApp Configuration (NEW - Meta Cloud API) ============
# Step 1: Set up WhatsApp Business Account at https://business.facebook.com
# Step 2: Get credentials from WhatsApp Manager
# Step 3: Fill in values below

# WhatsApp API Base URL (use this exact URL)
WHATSAPP_BASE_URL=https://graph.facebook.com/v18.0

# Your WhatsApp Phone Number ID (found in WhatsApp Manager > Phone Numbers)
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxx

# WhatsApp Permanent Bearer Token (Settings > User Tokens > Generate)
# ⚠️ KEEP THIS SECRET - DO NOT SHARE OR COMMIT TO GIT
WHATSAPP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Enable WhatsApp notifications (false by default - set to true after verification)
WHATSAPP_ENABLED=false

# ============ NOTIFICATION CHANNEL SELECTION ============
# ⚠️ IMPORTANT: Use ONLY ONE channel at a time
# Uncomment/set the channel you want to use
# All other channels must be commented out or set to false

# Option 1: Use SMS (AWS SNS)
NOTIFICATION_CHANNEL=sms

# Option 2: Use Email (SMTP)
# NOTIFICATION_CHANNEL=email

# Option 3: Use WhatsApp (Meta Cloud API)
# NOTIFICATION_CHANNEL=whatsapp

# Option 4: Use In-App (Database)
# NOTIFICATION_CHANNEL=in_app

# ============ Cloudflare R2 Configuration (Object Storage) ============
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_BUCKET=your-bucket-name
CLOUDFLARE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Optional: use a public Cloudflare R2 bucket or CDN origin URL to serve images as permanent URLs.
# This must point to the bucket root or a valid object host.
# Example public root for direct object access:
#   CLOUDFLARE_PUBLIC_URL=https://your-account-id.r2.cloudflarestorage.com/sappay
# or if you have a custom domain mapped to the bucket root:
#   CLOUDFLARE_PUBLIC_URL=https://cdn.sappey.com
# Do NOT set this to your website homepage host unless that host is configured
# to serve R2 objects directly from the bucket root.
CLOUDFLARE_PUBLIC_URL=https://sappey.com

# ============ Payment Gateway Configuration ============
# Supported payment methods in checkout: cod, card, upi, netbanking
# Set PAYMENT_PROVIDER to the gateway you will use for card/upi/netbanking payments.
PAYMENT_PROVIDER=razorpay
PAYMENT_API_KEY=your-payment-provider-api-key
PAYMENT_API_SECRET=your-payment-provider-api-secret
PAYMENT_WEBHOOK_SECRET=your-payment-provider-webhook-secret

